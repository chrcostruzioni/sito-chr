{%- set L = lingue[lang] -%}
{%- set I = impresa -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ I.dominio }}{{ page.url }}">
{%- if alt %}
<link rel="alternate" hreflang="{{ lang }}" href="{{ I.dominio }}{{ page.url }}">
<link rel="alternate" hreflang="{{ 'en' if lang == 'it' else 'it' }}" href="{{ I.dominio }}{{ alt }}">
<link rel="alternate" hreflang="x-default" href="{{ I.dominio }}{{ page.url if lang == 'it' else alt }}">
{%- endif %}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ I.dominio }}{{ (ogimage or 'pia-13.jpg') | img }}">
<meta property="og:locale" content="{{ 'it_IT' if lang == 'it' else 'en_GB' }}">
<link rel="icon" href="/media/img/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/media/font/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/media/stile.css">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"GeneralContractor","name":"{{ I.nome }}","legalName":"{{ I.ragione_sociale }}","vatID":"IT{{ I.piva }}","url":"{{ I.dominio }}/","telephone":"{{ I.telefono_link }}","image":"{{ I.dominio }}/media/img/pia-13.jpg","logo":"{{ I.dominio }}/media/img/chr-orizzontale-nero.svg","founder":{"@type":"Person","name":"{{ I.titolare }}"},"areaServed":[{"@type":"City","name":"Bologna"},{"@type":"GeoCircle","geoMidpoint":{"@type":"GeoCoordinates","latitude":44.4949,"longitude":11.3426},"geoRadius":20000}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"}],"knowsLanguage":["it","en"],"sameAs":["https://www.instagram.com/{{ I.instagram }}/"{% if I.facebook %},"{{ I.facebook }}"{% endif %}]}</script>
</head>
<body>
<header>
  <div class="wrap bar">
    <a class="logo" href="{{ L.home }}" aria-label="{{ L.home_label }}"><img src="/media/img/chr-orizzontale-nero.svg" alt="CHR Costruzioni" width="140" height="44"></a>
    <button class="menu-btn" type="button" id="menuBtn" aria-expanded="false" aria-controls="mainNav">Menu</button>
    <nav id="mainNav" aria-label="{{ L.menu_label }}">
      <ul>
        {%- for m in L.menu %}
        <li><a href="{{ m.u }}"{% if page.url == m.u or (m.u != L.home and page.url.startsWith(m.u)) %} aria-current="page"{% endif %}>{{ m.t }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div style="display:flex;align-items:center;gap:14px">
      <a class="tel" href="tel:{{ I.telefono_link }}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span>{{ I.telefono }}</span></a>
      {%- if alt %}
      <a class="lang" href="{{ alt }}" hreflang="{{ 'en' if lang == 'it' else 'it' }}" lang="{{ 'en' if lang == 'it' else 'it' }}" aria-label="{{ 'English version' if lang == 'it' else 'Versione italiana' }}">{% if lang == 'it' %}<b>IT</b> | <span>EN</span>{% else %}<span>IT</span> | <b>EN</b>{% endif %}</a>
      {%- endif %}
      <a class="btn btn-primary" href="{{ L.preventivo }}">{{ L.btn_preventivo }}</a>
    </div>
  </div>
</header>
<main>
{{ content | safe }}
{%- if not nocta %}
<section class="band navy">
  <div class="wrap cta-band">
    <div class="stack" style="gap:8px"><h2>{{ L.cta_title }}</h2><p>{{ L.cta_text }}</p></div>
    <a class="btn btn-light" href="{{ L.preventivo }}">{{ L.cta_btn }}</a>
  </div>
</section>
{%- endif %}
</main>
<footer>
  <div class="wrap cols">
    <div class="stack" style="gap:12px"><img src="/media/img/chr-orizzontale-bianco.svg" alt="CHR Costruzioni" style="height:44px;width:auto"><p>{{ L.footer_text }}</p></div>
    <div><h3>{{ L.footer_servizi }}</h3><ul>{% for m in L.menu %}{% if loop.index <= 3 %}<li><a href="{{ m.u }}">{{ m.t }}</a></li>{% endif %}{% endfor %}<li><a href="{{ L.menu[4].u }}">{{ L.bonus_label }}</a></li></ul></div>
    <div><h3>{{ L.footer_contatti }}</h3><ul><li><a href="tel:{{ I.telefono_link }}">{{ I.telefono }}</a></li><li>{{ I.orari_it if lang == 'it' else I.orari_en }}</li><li><a href="https://www.instagram.com/{{ I.instagram }}/">@{{ I.instagram }}</a></li>{% if I.facebook %}<li><a href="{{ I.facebook }}">Facebook</a></li>{% endif %}<li>{{ I.ragione_sociale }}</li><li>{{ L.piva }} {{ I.piva }}</li></ul></div>
  </div>
</footer>
<a class="wa" href="https://wa.me/{{ I.whatsapp }}" aria-label="{{ L.wa_label }}"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3z"/></svg>WhatsApp</a>
<script>
(function(){var n=document.getElementById("mainNav"),b=document.getElementById("menuBtn");b.addEventListener("click",function(){var o=n.classList.toggle("open");b.setAttribute("aria-expanded",o?"true":"false");});})();
</script>
</body>
</html>
